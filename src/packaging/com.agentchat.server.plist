<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.agentchat.server</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/agentchat/agentchat-launcher</string>
    <string>-runtime</string><string>codex</string>
    <string>-data</string><string>/ABSOLUTE/PATH/TO/agentchat-data</string>
    <string>-listen</string><string>127.0.0.1:8877</string>
    <string>-codex-path</string><string>/ABSOLUTE/PATH/TO/codex</string>
    <string>-jq-path</string><string>/ABSOLUTE/PATH/TO/jq</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/agentchat.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/agentchat-error.log</string>
</dict></plist>
